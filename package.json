{
  "name": "blindtest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/client.tsx --bundle --minify --format=esm --outdir=public/dist",
    "dev": "npm run build && (esbuild src/client.tsx --bundle --format=esm --outdir=public/dist --watch=forever & wrangler dev --ip 0.0.0.0 --port 1999)",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}