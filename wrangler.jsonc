{
  // Cloudflare config: the website (public/) + the game rooms (src/server.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blindtest",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  // Your own domain (with and without www). The workers.dev link keeps working too.
  "routes": [
    { "pattern": "geekasong.com", "custom_domain": true },
    { "pattern": "www.geekasong.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "BlindTestServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BlindTestServer"] }]
}
